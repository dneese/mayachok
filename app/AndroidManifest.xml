<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.dneese.mayachok"
    android:versionCode="11"
    android:versionName="1.11">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Тільки для TYPE_SIGNIFICANT_MOTION: дешевшего тригера «людина
         рухається», який працює в сенсорній мікросхемі. Без нього
         застосунок просто використовує акселерометр — трохи дорожче,
         але працює. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Трекер має піднятися сам після перезавантаження телефону: START_STICKY
         переживає вбитий процес, але не перезавантаження. Без цього телефон
         мовчить доти, доки хтось не відкриє застосунок руками. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Дозволу на сповіщення немає: єдине сповіщення — технічне, від самого
         трекера. Android 13+ просто не покаже його в шухляді, але сервіс
         працюватиме. Колишній чат, що слави про повідомлення, прибрано. -->

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- mayachok://join/xxxx-xxxx-xxxx — запрошення відкриває застосунок -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mayachok" android:host="join" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackerService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Піднімає трекер після перезавантаження й оновлення застосунку.
             MY_PACKAGE_REPLACED потрібен, щоб після оновлення з Releases
             трекер продовжив роботу, а не чекав ручного «Почати». -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
