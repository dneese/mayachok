<?xml version="1.0" encoding="utf-8"?>
<!-- Чип інтервалу: вибраний — заливка, решта — контур. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_faint" />
            <corners android:radius="21dp" />
            <stroke android:width="1.5dp" android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="21dp" />
            <stroke android:width="1.5dp" android:color="@color/divider" />
        </shape>
    </item>
</selector>
