    <!-- 2. група -->
    <string name="label_group">Група</string>
    <string name="hint_group_new">Створіть нову групу й надішліть посилання родичі чи друзям.</string>
    <string name="btn_create_group">Створити групу</string>
    <string name="hint_group_join">Або вставте посилання, яке вам надіслали:</string>
    <string name="hint_code">https://…</string>
    <string name="btn_join_group">Приєднатися</string>
    <string name="btn_share">Поділитися</string>
    <string name="btn_copy_link">Копіювати</string>
    <string name="btn_map">Відкрити мапу</string>
    <string name="btn_back">Назад</string>
    <string name="btn_forget">Вийти з групи</string>
    <string name="forget_confirm">Вийти з групи? Трекер зупиниться, а інші побачать, що вас більше немає на карті. Код групи буде забуто.</string>

    <!-- 3. трекер -->
    <string name="label_interval">Як часто надсилати</string>
    <string name="note_battery">Частіше — точніше, але швидше сідає батарея. Поки трекер увімкнено, GPS працює весь час.</string>
    <string name="btn_start">Почати</string>
    <string name="btn_stop">Зупинити</string>

    <!-- діагностика -->
    <string name="label_diag">Діагностика</string>
    <string name="hint_diag">Технічні журнали, якщо точки не йдуть. Координат не містить, зникає через 48 годин.</string>
    <string name="diag_battery_hint">Якщо Android зупиняє застосунок у фоні, точки не йдуть. Найчастіше допомагає вимкнути оптимізацію батареї для «Маячка» і вимкнути режим енергозбереження.</string>
    <string name="diag_open_settings">Відкрити налаштування</string>
    <string name="diag_bg_hint">«Увесь час» не надано — після перезавантаження трекер не підніметься сам. Це в налаштуваннях → Геолокація → «Дозволити увесь час».</string>

    <!-- довідка -->
    <string name="label_help">Довідка</string>
    <string name="hint_help">Всім у групі видно одне одного. Точка не зникає: якщо людина давно онлайн, видно, де вона востаннє була.</string>
    <string name="btn_github">Проєкт</string>

