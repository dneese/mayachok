<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Верхній апбар -->
    <LinearLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:src="@drawable/ic_back"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Головний екран -->
    <ScrollView
        android:id="@+id/main_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Стан -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_status_dot"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 1. Ім'я -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/label_name" />

                <EditText
                    android:id="@+id/name"
                    style="@style/Field"
                    android:hint="@string/hint_name"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="24" />
            </LinearLayout>

            <!-- 2. Група -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/label_group" />

                <!-- ще немає групи -->
                <LinearLayout
                    android:id="@+id/group_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Hint"
                        android:text="@string/hint_group_new" />

                    <Button
                        android:id="@+id/create"
                        style="@style/Btn"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_create_group" />

                    <TextView
                        style="@style/Hint"
                        android:layout_marginTop="18dp"
                        android:text="@string/hint_group_join" />

                    <EditText
                        android:id="@+id/code"
                        style="@style/Field"
                        android:hint="@string/hint_code"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLines="3" />

                    <Button
                        android:id="@+id/join"
                        style="@style/Btn.Secondary"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_join_group" />
                </LinearLayout>

                <!-- група є -->
                <LinearLayout
                    android:id="@+id/group_ready"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/code_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_brand"
                        android:padding="12dp"
                        android:textColor="@color/brand"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/hint_code_share" />

                    <Button
                        android:id="@+id/share"
                        style="@style/Btn"
                        android:layout_marginTop="12dp"
                        android:text="@string/btn_share" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/copy"
                            style="@style/Btn.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_copy"
                            android:drawablePadding="4dp"
                            android:text="@string/btn_copy_link" />

                        <Button
                            android:id="@+id/map"
                            style="@style/Btn.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_map" />

                        <Button
                            android:id="@+id/chat"
                            style="@style/Btn.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/btn_chat" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/forget"
                        style="@style/Btn.Danger"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_forget" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Трекер -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/label_interval" />

                <Spinner
                    android:id="@+id/interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/note_battery" />

                <Button
                    android:id="@+id/toggle"
                    style="@style/Btn"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_start" />
            </LinearLayout>

            <!-- Сповіщення чату: окремий перемикач, бо це фонова робота -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/label_chat_alerts" />

                    <TextView
                        style="@style/Hint"
                        android:text="@string/hint_chat_alerts" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/chat_alerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/label_chat_alerts"
                    android:minWidth="48dp" />
            </LinearLayout>

            <!-- Довідка -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginBottom="8dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/label_help" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/hint_help" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Прямого посилання на APK тут немає свідомо:
                         застосунок веде на сторінку проєкту, де в README
                         лежить посилання на останню версію. -->
                    <Button
                        android:id="@+id/github"
                        style="@style/Btn.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_github" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Екран мапи -->
    <LinearLayout
        android:id="@+id/map_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:visibility="gone">

        <WebView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- Екран чату -->
    <LinearLayout
        android:id="@+id/chat_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?android:attr/actionBarSize"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Область повідомлень: шпалера + порожній стан, накладений по центру.
             Раніше chat_empty стояв після ScrollView, тож при weight=1 його
             виштовхувало за межі екрана і підказку не було видно ніколи. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_wallpaper">

            <ScrollView
                android:id="@+id/chat_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chat_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </ScrollView>

            <TextView
                android:id="@+id/chat_empty"
                style="@style/Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/chat_empty" />
        </FrameLayout>

        <!-- Поле вводу й кругла кнопка надсилення, як у Telegram -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="3dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <EditText
                android:id="@+id/chat_input"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="@string/chat_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp" />

            <ImageButton
                android:id="@+id/chat_send"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_send_button"
                android:contentDescription="@string/chat_send"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>

    <!-- Нижнє меню -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/tab_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_group" />

            <TextView
                android:id="@+id/tab_group_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_group"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_map" />

            <TextView
                android:id="@+id/tab_map_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_map"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_chat" />

            <TextView
                android:id="@+id/tab_chat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_chat"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
